# Database
# Local dev without Docker falls back to SQLite automatically if DATABASE_URL is unset.
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/banking_assistant

# Vector store
CHROMA_PERSIST_DIR=./chroma_db

# LLM provider: stub | groq | gemini | ollama
# stub = deterministic offline responses, no network/API key needed (used in tests/CI)
LLM_PROVIDER=stub
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Fairness
FAIRNESS_PARITY_THRESHOLD=0.10
