# Database
# Local dev without Docker falls back to SQLite automatically if DATABASE_URL is unset.
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/banking_assistant

# Vector store
CHROMA_PERSIST_DIR=./chroma_db

# LLM provider: stub | groq | gemini | anthropic | ollama
# stub = deterministic offline responses, no network/API key needed (used in tests/CI)
# If the chosen provider has no key set below, the app falls back to stub automatically.
LLM_PROVIDER=stub
# LLM_MODEL overrides the provider's default model name below if set.
LLM_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Fairness
FAIRNESS_PARITY_THRESHOLD=0.10

# Admin app (frontend/admin_app.py) — leave unset to open with a warning banner, no password
ADMIN_PASSWORD=
